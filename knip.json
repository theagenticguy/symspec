{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["wink-nlp", "wink-eng-lite-web-model"],
  "ignoreBinaries": ["diff"],
  "rules": {
    "dependencies": "error",
    "devDependencies": "warn",
    "unlisted": "error",
    "exports": "off",
    "types": "off",
    "files": "warn"
  }
}
