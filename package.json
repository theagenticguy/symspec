{
  "name": "symspec",
  "version": "1.0.0",
  "type": "module",
  "description": "Prove your software requirements consistent, or get an honest work list. EARS authoring, INCOSE GtWR lint, Z3 SMT conflict proofs with unsat-core evidence, and unbounded state-model reachability — behind an agent-first CLI with typed JSON envelopes and 81 stable codes.",
  "keywords": [
    "requirements",
    "requirements-engineering",
    "ears",
    "incose",
    "gtwr",
    "specification",
    "formal-methods",
    "formal-verification",
    "smt",
    "smt-solver",
    "z3",
    "spacer",
    "reachability",
    "model-checking",
    "invariant",
    "neurosymbolic",
    "static-analysis",
    "cli",
    "agent",
    "coding-agent",
    "agent-friendly",
    "mcp",
    "claude-code",
    "effect"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theagenticguy/symspec.git"
  },
  "homepage": "https://github.com/theagenticguy/symspec#readme",
  "bugs": {
    "url": "https://github.com/theagenticguy/symspec/issues"
  },
  "bin": {
    "symspec": "./bin/symspec.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "cli": "node dist/cli.mjs",
    "bench": "./scripts/bench.sh",
    "bench:budget": "tsx scripts/budget-curve.ts",
    "check": "biome ci . && tsc --noEmit && pnpm run check:agents && pnpm run gate:reachability && pnpm run build && vitest run && pnpm run knip",
    "gen:agents": "tsx scripts/gen-agents.ts",
    "check:agents": "tsx scripts/gen-agents.ts --stdout | diff -u AGENTS.md - >/dev/null || (echo \"AGENTS.md is stale — run pnpm gen:agents\" >&2; exit 1)",
    "gate:reachability": "tsx scripts/reachability-feasibility.ts",
    "knip": "knip --no-progress",
    "pack:dry": "npm pack --dry-run",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "@huggingface/tokenizers": "^0.1.3",
    "effect": "4.0.0-beta.102",
    "onnxruntime-web": "^1.27.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "z3-solver": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.7.0",
    "knip": "^6.13.1",
    "lefthook": "^2.1.6",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.21.0"
}
