{
  "name": "symspec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neurosymbolic spec validator for coding agents: EARS requirements via regex-first parsing, INCOSE GtWR lint, and Z3 SMT formal conflict detection with unsat-core evidence, plus optional Lean 4 certification and an agent-friendly CLI (manifest, typed JSON envelopes, stable error codes).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theagenticguy/symspec.git"
  },
  "homepage": "https://github.com/theagenticguy/symspec#readme",
  "bugs": {
    "url": "https://github.com/theagenticguy/symspec/issues"
  },
  "packageManager": "pnpm@11.1.1",
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "bin": {
    "symspec": "./bin/symspec.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "knip": "knip",
    "check": "biome ci . && tsc --noEmit && vitest run && knip",
    "hooks:install": "lefthook install",
    "gen:agents": "tsx scripts/gen-agents.ts",
    "check:agents": "tsx scripts/gen-agents.ts --stdout | diff -u AGENTS.md - >/dev/null || (echo \"AGENTS.md is stale — run pnpm gen:agents\" >&2; exit 1)"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "z3-solver": "^4.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.7.0",
    "@vitest/coverage-v8": "^4.1.6",
    "commander": "^14.0.3",
    "knip": "^6.13.1",
    "lefthook": "^2.1.6",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "z3-solver"
    ]
  }
}
