{
  "name": "symspec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neurosymbolic spec validator: EARS requirements graph in Automerge, three-tier solver (deterministic + Bedrock ensemble + Opus 4.7 arbiter), CLI + MCP",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theagenticguy/symspec.git"
  },
  "homepage": "https://github.com/theagenticguy/symspec#readme",
  "bugs": {
    "url": "https://github.com/theagenticguy/symspec/issues"
  },
  "packageManager": "pnpm@11.1.1",
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "symspec": "./bin/symspec.mjs",
    "symspec-mcp": "./bin/symspec-mcp.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:inc": "tsx scripts/smoke-incremental.ts",
    "smoke:solvers": "tsx scripts/smoke-solvers.ts",
    "smoke:all": "tsx scripts/smoke.ts && tsx scripts/smoke-incremental.ts && tsx scripts/smoke-solvers.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "knip": "knip",
    "check": "biome ci . && tsc --noEmit && vitest run && knip",
    "hooks:install": "lefthook install"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@automerge/automerge": "^3.2.6",
    "@aws-sdk/client-bedrock-runtime": "^3.1046.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^25.7.0",
    "@vitest/coverage-v8": "^4.1.6",
    "commander": "^14.0.3",
    "knip": "^6.13.1",
    "lefthook": "^2.1.6",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
